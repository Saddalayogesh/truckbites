# ============================================================================
# Root .dockerignore - build context for most services is the repo root, so
# exclude everything that should not be shipped to the Docker daemon.
# ============================================================================

# Git
.git
.gitignore
.gitattributes

# Maven build outputs
**/target/

# Node / frontend
frontend/truckbites-frontend/node_modules
frontend/truckbites-frontend/dist

# IDE / OS
.idea
.vscode
*.iml
.DS_Store
Thumbs.db

# Env / secrets - never ship real secrets into an image build context
**/.env
**/.env.*

# Logs / misc
*.log
