# ============================================================================
# TruckBites Microservices — Environment Variables
# ============================================================================
# Copy this file to .env and adjust values as needed:
#
#   cp .env.example .env
#
# Docker Compose automatically loads .env from the project root when you run:
#
#   docker compose up -d
#
# JWT_SECRET is now REQUIRED — there is deliberately no hardcoded default.
# Generate your own with:
#
#   openssl rand -hex 32
#
# ============================================================================

# ---------------------------------------------------------------------------
# MySQL Root Password
# ---------------------------------------------------------------------------
# Used by all 6 database containers (auth, user, truck, menu, order, payment).
# Override this to a strong password for non-local deployments.
MYSQL_ROOT_PASSWORD=truckbites_root

# ---------------------------------------------------------------------------
# JWT Secret (REQUIRED)
# ---------------------------------------------------------------------------
# Shared HMAC-SHA256 secret used by every service to sign & verify JWT tokens.
# MUST be at least 256 bits (64 hex chars). Generate your own value — never
# ship or commit a real secret.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ---------------------------------------------------------------------------
# Mailtrap SMTP — Notification Service
# ---------------------------------------------------------------------------
# REQUIRED for email sending.  Get free credentials at https://mailtrap.io
# (Email Testing -> React Demo Inbox -> SMTP Settings -> Credentials)
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=

# ---------------------------------------------------------------------------
# Frontend — Vite API Base URL
# ---------------------------------------------------------------------------
# The base URL the React app uses to reach the API Gateway.
# In development (npm run dev) this points to localhost.
# In production the frontend is served from the same origin, so it can be "/".
VITE_API_BASE_URL=http://localhost:8080/api
